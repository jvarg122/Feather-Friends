Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program function
    3        | COMMENT program

    4 function: FUNC TOKEN_IDENTIFIER LEFTPAREN new_parameters RIGHTPAREN LEFTCURLY statements RIGHTCURLY
    5         | FUNC type TOKEN_IDENTIFIER LEFTPAREN new_parameters RIGHTPAREN LEFTCURLY statements RIGHTCURLY

    6 new_parameters: %empty
    7               | new_parameter

    8 new_parameter: type TOKEN_IDENTIFIER
    9              | type TOKEN_IDENTIFIER COMMA new_parameter

   10 parameters: %empty
   11           | parameter
   12           | parameter COMMA parameter

   13 parameter: TOKEN_IDENTIFIER
   14          | array_get_pointer

   15 statements: %empty
   16           | statements statement

   17 statement: new_variable
   18          | new_array
   19          | function_call
   20          | print
   21          | RETURN TOKEN_IDENTIFIER SEMICOLON
   22          | TOKEN_IDENTIFIER ASSIGN expressions SEMICOLON
   23          | array_get_pointer ASSIGN expressions SEMICOLON
   24          | COMMENT
   25          | BREAK SEMICOLON

   26 new_variable: type TOKEN_IDENTIFIER SEMICOLON
   27             | type TOKEN_IDENTIFIER ASSIGN NUMBER SEMICOLON

   28 new_array: type LEFTBRACKET NUMBER RIGHTBRACKET TOKEN_IDENTIFIER SEMICOLON

   29 array_get_pointer: TOKEN_IDENTIFIER LEFTBRACKET NUMBER RIGHTBRACKET

   30 type: INT

   31 print: PRINT LEFTPAREN parameter RIGHTPAREN SEMICOLON

   32 function_call: TOKEN_IDENTIFIER LEFTPAREN parameters SEMICOLON

   33 expressions: %empty
   34            | expressions expression

   35 expression: NUMBER
   36           | TOKEN_IDENTIFIER
   37           | array_get_pointer
   38           | LEFTPAREN expression RIGHTPAREN
   39           | expression PLUS expression
   40           | expression SUBTRACT expression
   41           | expression MULTIPLY expression
   42           | expression DIVIDE expression
   43           | expression MODULUS expression


