Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program function

    3 function_header: FUNC TOKEN_IDENTIFIER

    4 function: function_header LEFTPAREN new_parameters RIGHTPAREN LEFTCURLY statements RIGHTCURLY

    5 new_parameters: %empty
    6               | new_parameter

    7 new_parameter: type TOKEN_IDENTIFIER
    8              | type TOKEN_IDENTIFIER COMMA new_parameter

    9 parameters: %empty
   10           | parameter

   11 parameter: expressions COMMA parameter
   12          | expressions

   13 statements: %empty
   14           | statements statement

   15 statement: new_variable
   16          | new_array
   17          | function_call
   18          | print
   19          | if_statement
   20          | while_statement
   21          | read_statement
   22          | return_statement
   23          | assign_statement
   24          | BREAK SEMICOLON
   25          | CONTINUE SEMICOLON

   26 if_statement: IF boolean_expressions LEFTCURLY statements RIGHTCURLY else_statement

   27 new_array: type LEFTBRACKET NUMBER RIGHTBRACKET TOKEN_IDENTIFIER SEMICOLON

   28 array_get_pointer: TOKEN_IDENTIFIER LEFTBRACKET NUMBER RIGHTBRACKET

   29 assign_statement: TOKEN_IDENTIFIER ASSIGN NUMBER SEMICOLON
   30                 | TOKEN_IDENTIFIER ASSIGN expressions SEMICOLON
   31                 | TOKEN_IDENTIFIER LEFTBRACKET NUMBER RIGHTBRACKET ASSIGN NUMBER SEMICOLON
   32                 | TOKEN_IDENTIFIER LEFTBRACKET NUMBER RIGHTBRACKET ASSIGN expressions SEMICOLON

   33 return_statement: RETURN expressions SEMICOLON

   34 else_statement: ELSE LEFTCURLY statement RIGHTCURLY
   35               | %empty

   36 while_statement: WHILE boolean_expressions while_store LEFTCURLY statements RIGHTCURLY

   37 while_store: %empty

   38 read_statement: READ LEFTPAREN TOKEN_IDENTIFIER RIGHTPAREN SEMICOLON

   39 boolean_expressions: expression GREATER expression
   40                    | expression LESS expression
   41                    | expression LESSEQUAL expression
   42                    | expression GREATEREQUAL expression
   43                    | expression EQUALITY expression
   44                    | expression NOTEQUAL expression

   45 new_variable: type TOKEN_IDENTIFIER SEMICOLON
   46             | type TOKEN_IDENTIFIER ASSIGN NUMBER SEMICOLON

   47 variable: NUMBER
   48         | TOKEN_IDENTIFIER
   49         | array_get_pointer
   50         | function_call

   51 type: INT

   52 print: PRINT LEFTPAREN variable RIGHTPAREN SEMICOLON

   53 function_call: TOKEN_IDENTIFIER LEFTPAREN parameters RIGHTPAREN

   54 expressions: %empty
   55            | expressions expression

   56 expression: variable
   57           | expression PLUS expression
   58           | expression SUBTRACT expression
   59           | expression MULTIPLY expression
   60           | expression DIVIDE expression
   61           | expression MODULUS expression
   62           | LEFTPAREN expression RIGHTPAREN


