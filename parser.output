Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program function

    3 function: FUNC TOKEN_IDENTIFIER LEFTPAREN new_parameters RIGHTPAREN LEFTCURLY statements RIGHTCURLY

    4 new_parameters: %empty
    5               | new_parameter

    6 new_parameter: type TOKEN_IDENTIFIER
    7              | type TOKEN_IDENTIFIER COMMA new_parameter

    8 parameters: %empty
    9           | parameter

   10 parameter: TOKEN_IDENTIFIER
   11          | TOKEN_IDENTIFIER COMMA parameter

   12 statements: %empty
   13           | statements statement

   14 statement: new_variable
   15          | function_call
   16          | print
   17          | RETURN TOKEN_IDENTIFIER SEMICOLON
   18          | TOKEN_IDENTIFIER ASSIGN expressions SEMICOLON
   19          | TOKEN_IDENTIFIER ASSIGN NUMBER SEMICOLON
   20          | BREAK SEMICOLON

   21 new_variable: type TOKEN_IDENTIFIER SEMICOLON
   22             | type TOKEN_IDENTIFIER ASSIGN NUMBER SEMICOLON

   23 type: INT

   24 print: PRINT LEFTPAREN TOKEN_IDENTIFIER RIGHTPAREN SEMICOLON

   25 function_call: TOKEN_IDENTIFIER LEFTPAREN parameters SEMICOLON

   26 expressions: %empty
